# Local planning files (not for git)
TASK-MAP.md
PLANOS.md
planos/
taskmap/
planning/
claude-code-boss/PLANOS.md
*-PLAN.md

# Análise/medição local (relatórios e payloads de calibração gerados em sessão).
# Mesma regra dos planos: são artefato do dev loop, não do produto — um `git add -A`
# não pode arrastá-los para o repo público.
*-REPORT.md
*-HANDOFF.md
test-payload-*.json

# Smoke tests (local-only, never versioned)
smoke/

# Runtime artifacts (PID files, log ring, dashboard state)
claude-code-boss/.runtime/

# Local docs (maps, plans — not for git)
docs/maps/
docs/plans/
docs/research/
# claude-code-boss/docs/: planning/analysis local-only. Product docs
# (GETTING-STARTED, CONFIGURATION, FUNCTIONAL-SPEC, features/) ARE versioned —
# keep ignoring only internal plan/analysis artifacts:
claude-code-boss/docs/*-PLAN.md
claude-code-boss/docs/plans/
claude-code-boss/docs/research/
claude-code-boss/docs/maps/

# Claude Code local config
.claude/

# MCP runtime data
.mcp-memory/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db

# Backups from legacy plugin-updater — defensive for old clones
*.bak-*/

# Node.js
node_modules/

# Logs
*.log
claude-code-boss/logs/

# Temporary files
*.tmp
*.temp
.tmp*
*/tmp/
*/temp/

# Build outputs
claude-code-boss/dist/
claude-code-boss/build/

# Test coverage
claude-code-boss/coverage/
claude-code-boss/.lcov*

# Environment variables
.env
.env.local
.env.*.local

# Cache local do hook de design (impeccable) — artefato de ferramenta do dev
.impeccable/
