{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/model-router-ensure.js"],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session-start-dispatcher.js"],
            "timeout": 125
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:claude-code-boss:brain-server",
            "tool": "hook_policy_inject",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "transcript_path": "${transcript_path}",
              "project_dir": "${CLAUDE_PROJECT_DIR}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:claude-code-boss:brain-server",
            "tool": "hook_curation_guard",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "transcript_path": "${transcript_path}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "project_dir": "${CLAUDE_PROJECT_DIR}"
            },
            "timeout": 8
          },
          {
            "type": "mcp_tool",
            "server": "plugin:claude-code-boss:brain-server",
            "tool": "hook_error_guard",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "transcript_path": "${transcript_path}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "project_dir": "${CLAUDE_PROJECT_DIR}"
            },
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:claude-code-boss:brain-server",
            "tool": "hook_policy_enforce_shadow",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "transcript_path": "${transcript_path}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "project_dir": "${CLAUDE_PROJECT_DIR}"
            },
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:claude-code-boss:brain-server",
            "tool": "hook_graph_guard",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "transcript_path": "${transcript_path}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "project_dir": "${CLAUDE_PROJECT_DIR}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:claude-code-boss:brain-server",
            "tool": "hook_posttoolusebash_dispatcher",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "transcript_path": "${transcript_path}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "tool_response": "${tool_response}",
              "project_dir": "${CLAUDE_PROJECT_DIR}"
            },
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:claude-code-boss:brain-server",
            "tool": "hook_file_edit_detect",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "transcript_path": "${transcript_path}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "project_dir": "${CLAUDE_PROJECT_DIR}"
            },
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:claude-code-boss:brain-server",
            "tool": "hook_policy_glob_inject",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "transcript_path": "${transcript_path}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "project_dir": "${CLAUDE_PROJECT_DIR}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:claude-code-boss:brain-server",
            "tool": "hook_skill_metric",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "transcript_path": "${transcript_path}",
              "prompt": "${prompt}",
              "command": "${command}",
              "command_name": "${command_name}",
              "project_dir": "${CLAUDE_PROJECT_DIR}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:claude-code-boss:brain-server",
            "tool": "hook_posttoolusefailure_dispatcher",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "transcript_path": "${transcript_path}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "error": "${error}",
              "is_interrupt": "${is_interrupt}",
              "duration_ms": "${duration_ms}",
              "project_dir": "${CLAUDE_PROJECT_DIR}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:claude-code-boss:brain-server",
            "tool": "hook_stop_dispatcher",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "transcript_path": "${transcript_path}",
              "stop_hook_active": "${stop_hook_active}",
              "project_dir": "${CLAUDE_PROJECT_DIR}"
            },
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/user-prompt-submit-dispatcher.js"],
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "server": "plugin:claude-code-boss:brain-server",
            "tool": "hook_correction_detect",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "transcript_path": "${transcript_path}",
              "prompt": "${prompt}",
              "project_dir": "${CLAUDE_PROJECT_DIR}"
            },
            "timeout": 5
          },
          {
            "type": "mcp_tool",
            "server": "plugin:claude-code-boss:brain-server",
            "tool": "hook_active_research_detect",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "transcript_path": "${transcript_path}",
              "prompt": "${prompt}",
              "project_dir": "${CLAUDE_PROJECT_DIR}"
            },
            "timeout": 5
          },
          {
            "type": "mcp_tool",
            "server": "plugin:claude-code-boss:brain-server",
            "tool": "brain_retrieve_context",
            "input": {
              "prompt": "${prompt}",
              "cwd": "${cwd}",
              "sessionRoot": "${CLAUDE_PROJECT_DIR}",
              "session_id": "${session_id}"
            },
            "timeout": 30
          }
        ]
      }
    ]
  }
}
